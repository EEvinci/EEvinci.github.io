---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate, readingTime } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'>; featured?: boolean; }
const { post, featured = false } = Astro.props;
---
<article class:list={['post-row', { featured }]}>
  <div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>·</span><span>{readingTime(post)} 分钟阅读</span></div>
  <a class="post-title" href={`/posts/${post.id}/`}><h3>{post.data.title}</h3><Icon name="arrow" size={23} /></a>
  <p>{post.data.description}</p>
  <div class="tag-list">{post.data.tags.map(tag => <a href={`/posts/?tag=${encodeURIComponent(tag)}`}># {tag}</a>)}</div>
</article>
