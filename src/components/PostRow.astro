---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
---
<article class="post-row"><div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>·</span><span>{readingTime(post)} 分钟阅读</span></div><a class="post-title" href={`/posts/${post.id}/`}><h3>{post.data.title}</h3><span aria-hidden="true">↗</span></a><p>{post.data.description}</p><div class="tag-list">{post.data.tags.map(tag => <span>{tag}</span>)}</div></article>
