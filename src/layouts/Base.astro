---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site } from '../lib/posts';
interface Props { title?: string; description?: string; article?: boolean; date?: Date; }
const { title, description = site.description, article = false, date } = Astro.props;
const pageTitle = title ? `${title} · Evinci` : site.title;
const path = Astro.url.pathname;
const canonical = new URL(path === '/404/' ? '/404.html' : path, Astro.site);
const nav = [{ href: '/', label: '首页' }, { href: '/posts/', label: '文章' }, { href: '/about/', label: '关于' }];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Evinci" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Evinci RSS" href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    <script is:inline>
      try {
        const preferred = localStorage.getItem('theme');
        document.documentElement.dataset.theme = preferred || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">跳到正文</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Evinci 首页"><span class="brand-mark">e<span>v</span>.</span><span class="brand-text">Evinci<span>NOTES & EXPLORATIONS</span></span></a>
        <div class="header-right">
          <nav aria-label="主导航">{nav.map(item => <a href={item.href} aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>)}</nav>
          <span class="header-divider"></span>
          <a class="icon-button" href="/posts/#search" aria-label="搜索文章"><Icon name="search" /></a>
          <button id="theme-toggle" class="icon-button theme-toggle" aria-label="切换明暗主题"><span class="moon"><Icon name="moon" /></span><span class="sun"><Icon name="sun" /></span></button>
        </div>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <div><a href="/" class="footer-name">Evinci<span>.</span></a><p>Stay curious. Keep building.</p></div>
        <div class="footer-links"><a href={site.github}>GitHub <Icon name="arrow" size={13} /></a><a href={`mailto:${site.email}`}>Email <Icon name="arrow" size={13} /></a><a href="/rss.xml"><Icon name="rss" size={14} /> RSS</a></div>
        <div class="footer-meta"><span>© {new Date().getFullYear()} Evinci</span><a href="https://github.com/EEvinci/EEvinci.github.io">Built with Astro · Hosted on GitHub</a></div>
      </footer>
    </div>
    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('theme', theme); } catch {}
      });
    </script>
  </body>
</html>
