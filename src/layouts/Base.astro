---
import '../styles/global.css';
import { site } from '../lib/posts';
interface Props { title?: string; description?: string; article?: boolean; date?: Date; }
const { title, description = site.description, article = false, date } = Astro.props;
const pageTitle = title ? `${title} · Evinci` : site.title;
const path = Astro.url.pathname;
const canonical = new URL(path === '/404/' ? '/404.html' : path, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Evinci" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Evinci RSS" href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Evinci 首页">Evinci<span class="brand-divider"></span><span class="brand-caption">PERSONAL NOTES</span></a>
        <nav aria-label="主导航">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>首页</a>
          <a href="/posts/" aria-current={path.startsWith('/posts/') || path.startsWith('/topics/') ? 'page' : undefined}>文章目录</a>
          <a class="github-link" href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer"><span>© {new Date().getFullYear()} Evinci</span><span class="footer-signature">Understand complexity. Act simply.</span><a href={`mailto:${site.email}`}>联系我 <span aria-hidden="true">↗</span></a></footer>
    </div>
  </body>
</html>
