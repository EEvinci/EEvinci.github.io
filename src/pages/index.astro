---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import character from '../assets/character.png';
const letters = (word: string, offset: number) => [...word].map((letter, index) => ({ letter, index: offset + index }));
---
<Base>
  <section class="identity-home interactive-home" aria-label="Evinci 的个人主页">
    <div class="paper-reveal" aria-hidden="true">
      <svg viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice"><g fill="none" stroke="currentColor" stroke-width="1.3"><path d="M60 190Q240 40 340 190T620 210T1120 110M90 570Q320 360 530 610T1100 530"/><circle cx="180" cy="140" r="66"/><circle cx="1000" cy="620" r="110"/><path d="M70 340h150m-75-75v150M840 130h140v100H840zM850 140l120 80m0-80l-120 80M540 120l40-25 40 25-40 25z"/><path stroke-dasharray="5 9" d="M220 340Q410 300 580 120T1000 620"/></g><g fill="currentColor" font-family="Georgia,serif" font-style="italic" font-size="25"><text x="70" y="500">What if?</text><text x="740" y="330">Make it real.</text><text x="400" y="720">Find the connection.</text></g><g fill="#b99353"><circle cx="580" cy="120" r="7"/><circle cx="1000" cy="620" r="8"/></g></svg>
    </div>
    <div class="identity-copy">
      <p class="eyebrow">A CURIOUS MIND</p>
      <h1 class="kinetic-title" lang="en" aria-label="Understand complexity. Act simply.">
        <span class="title-line title-understand" aria-hidden="true">{letters('Understand', 0).map(({letter,index}) => <span class="type-letter" style={`--letter:${index}`}>{letter}</span>)}</span>
        <span class="title-line title-complexity"><button type="button" class="word-button complexity-button" aria-label="把 complexity 化为 clarity" aria-pressed="false"><span class="complexity-original" aria-hidden="true">{letters('complexity.', 10).map(({letter,index}) => <span class="type-letter" style={`--letter:${index}`}>{letter}</span>)}</span><span class="clarity-word" aria-hidden="true">clarity.</span></button></span>
        <span class="title-line title-action"><button type="button" class="word-button act-button" aria-label="Act，让想法起飞"><span aria-hidden="true">{letters('Act', 21).map(({letter,index}) => <span class="type-letter" style={`--letter:${index}`}>{letter}</span>)}</span></button><span aria-hidden="true">{letters(' simply.', 24).map(({letter,index}) => <span class="type-letter" style={`--letter:${index}`}>{letter === ' ' ? '\u00a0' : letter}</span>)}</span></span>
      </h1>
      <div class="home-tools"><button type="button" class="replay-type" aria-label="重播英文标题打字效果">重播文字 <span aria-hidden="true">↻</span></button><button type="button" class="reveal-toggle" aria-pressed="false">探索纸面 <span aria-hidden="true">✧</span></button></div>
      <p class="identity-title">有结构的好奇心</p>
      <p class="identity-intro tilt-surface">我是 Evinci，关注 AI、教育与创作。<br />在复杂的问题里寻找结构，把新的理解带回实践。</p>
      <ul class="personal-tags" aria-label="个人标签"><li>清晰</li><li>自主</li><li>生动</li></ul>
    </div>
    <div class="identity-portrait">
      <span class="portrait-index">EV / 01</span>
      <div class="portrait-window"></div><div class="portrait-inset"></div><span class="blue-tab"></span>
      <Image class="character" src={character} alt="Evinci 的 Q 版个人形象" width={373} height={560} format="webp" loading="eager" fetchpriority="high" />
      <button class="idea-trigger" type="button" aria-label="接住一颗灵感" aria-pressed="false"><span aria-hidden="true">✧</span></button><span class="idea-orb" aria-hidden="true"></span>
      <button class="handnote flip-note" type="button" aria-label="换个角度看看，点击翻转便签" aria-pressed="false"><span class="note-inner"><span class="note-front">换个角度看看。<small>点击翻转 ↗</small></span><span class="note-back">新的视角，新的发现。</span></span></button>
    </div>
    <span class="home-plane" aria-hidden="true"></span>
    <span class="home-status sr-only" role="status"></span>
  </section>
  <section class="thinking-strip" aria-label="我的思考方式">
    <div class="thinking-caption"><span class="eyebrow">HOW I THINK</span><span>我的思考方式</span></div>
    <div class="thinking-step"><span class="step-number">01.</span><div><span class="step-label">OBSERVE</span><p>先看关系，再看细节。</p></div></div>
    <div class="thinking-step"><span class="step-number">02.</span><div><span class="step-label">THINK</span><p>保持好奇，认真求证。</p></div></div>
    <a class="writing-entry tilt-surface" href="/posts/"><span class="folder-tab">FIELD NOTES</span><span class="writing-entry-title">进入文章目录 <span aria-hidden="true">↗</span></span><span class="writing-entry-caption">学习 · 思考 · 实践</span></a>
  </section>
</Base>
<script>
  import '../scripts/home-interactions';
</script>
